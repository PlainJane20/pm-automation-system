# PM Automation System - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# JIRA Configuration (REQUIRED)
# =============================================================================
# Your JIRA instance URL (no trailing slash)
JIRA_URL=https://yourcompany.atlassian.net

# Your JIRA account email
JIRA_EMAIL=your-email@company.com

# JIRA API Token - Generate at: https://id.atlassian.com/manage/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Your JIRA project key (e.g., "PILOT", "ENG", "PM")
JIRA_PROJECT_KEY=PILOT

# =============================================================================
# Database Configuration
# =============================================================================
# For development (SQLite) - creates local file
DATABASE_URL=sqlite+aiosqlite:///./pm_automation.db

# For production (PostgreSQL) - uncomment and configure
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pm_automation

# =============================================================================
# OpenAI Configuration (OPTIONAL - for AI features)
# =============================================================================
# Get API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Enable AI-powered classification and duplicate detection
ENABLE_AI_CLASSIFICATION=false

# =============================================================================
# Slack Integration (OPTIONAL)
# =============================================================================
# Slack Bot Token - Create app at: https://api.slack.com/apps
SLACK_BOT_TOKEN=

# Channel for program status updates
SLACK_NOTIFICATIONS_CHANNEL=#program-status

# Enable Slack notifications
ENABLE_SLACK_NOTIFICATIONS=false

# =============================================================================
# Email Configuration (OPTIONAL - for email intake)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=requests@yourcompany.com

ENABLE_EMAIL_INTAKE=false

# =============================================================================
# Automation Rules Configuration
# =============================================================================
# Number of days before warning about stale tickets
STALE_TICKET_DAYS=60

# SLA check interval (minutes)
SLA_CHECK_INTERVAL_MINUTES=30

# Duplicate detection similarity threshold (0.0 to 1.0)
DUPLICATE_SIMILARITY_THRESHOLD=0.8

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=false
APP_NAME=PM Automation System
